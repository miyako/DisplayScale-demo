{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"windowMinWidth": 720,
	"windowMinHeight": 570,
	"windowMaxWidth": 720,
	"windowMaxHeight": 570,
	"width": 720,
	"height": 570,
	"events": [
		"onLoad",
		"onDataChange",
		"onClick",
		"onUnload"
	],
	"windowTitle": "DisplayScale — Scale Lab",
	"destination": "detailScreen",
	"method": "method.4dm",
	"pages": [
		{
			"objects": {
				"canvas": {
					"type": "rectangle",
					"left": 0,
					"top": 0,
					"width": 720,
					"height": 570,
					"fill": "automatic",
					"stroke": "transparent"
				}
			}
		},
		{
			"objects": {
				"labTitle": {
					"type": "text",
					"left": 24,
					"top": 18,
					"width": 520,
					"height": 32,
					"text": "Scale Lab",
					"class": "appTitle"
				},
				"btnClose": {
					"type": "button",
					"left": 600,
					"top": 16,
					"width": 96,
					"height": 30,
					"text": "Close",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"rule": {
					"type": "rectangle",
					"left": 24,
					"top": 88,
					"width": 672,
					"height": 1,
					"stroke": "transparent",
					"class": "rule"
				},
				"inputsTitle": {
					"type": "text",
					"left": 32,
					"top": 102,
					"width": 640,
					"height": 18,
					"text": "Inputs",
					"class": "section"
				},
				"nativeLabel": {
					"type": "text",
					"left": 32,
					"top": 126,
					"width": 110,
					"height": 16,
					"text": "Native px width",
					"class": "statCaption"
				},
				"inpNative": {
					"type": "input",
					"left": 32,
					"top": 144,
					"width": 96,
					"height": 26,
					"dataSource": "Form.lab.nativeWidth",
					"dataSourceTypeHint": "integer",
					"class": "field"
				},
				"stepNative": {
					"type": "stepper",
					"left": 132,
					"top": 144,
					"width": 14,
					"height": 26,
					"dataSource": "Form.lab.nativeWidth",
					"dataSourceTypeHint": "integer",
					"min": 320,
					"max": 16384,
					"step": 60,
					"events": [
						"onDataChange"
					]
				},
				"pointsLabel": {
					"type": "text",
					"left": 170,
					"top": 126,
					"width": 100,
					"height": 16,
					"text": "UI point width",
					"class": "statCaption"
				},
				"inpPoints": {
					"type": "input",
					"left": 170,
					"top": 144,
					"width": 86,
					"height": 26,
					"dataSource": "Form.lab.pointsWidth",
					"dataSourceTypeHint": "integer",
					"class": "field"
				},
				"stepPoints": {
					"type": "stepper",
					"left": 260,
					"top": 144,
					"width": 14,
					"height": 26,
					"dataSource": "Form.lab.pointsWidth",
					"dataSourceTypeHint": "integer",
					"min": 320,
					"max": 16384,
					"step": 40,
					"events": [
						"onDataChange"
					]
				},
				"dpiLabel": {
					"type": "text",
					"left": 298,
					"top": 126,
					"width": 90,
					"height": 16,
					"text": "Windows dpi",
					"class": "statCaption"
				},
				"inpDpi": {
					"type": "input",
					"left": 298,
					"top": 144,
					"width": 70,
					"height": 26,
					"dataSource": "Form.lab.dpi",
					"dataSourceTypeHint": "integer",
					"class": "field"
				},
				"stepDpi": {
					"type": "stepper",
					"left": 372,
					"top": 144,
					"width": 14,
					"height": 26,
					"dataSource": "Form.lab.dpi",
					"dataSourceTypeHint": "integer",
					"min": 72,
					"max": 384,
					"step": 12,
					"events": [
						"onDataChange"
					]
				},
				"labBig": {
					"type": "text",
					"left": 32,
					"top": 188,
					"width": 240,
					"height": 56,
					"text": "—",
					"class": "hugeNumber"
				},
				"labCaption": {
					"type": "text",
					"left": 32,
					"top": 246,
					"width": 420,
					"height": 18,
					"text": "…",
					"class": "muted"
				},
				"labMac": {
					"type": "text",
					"left": 32,
					"top": 278,
					"width": 656,
					"height": 24,
					"text": "",
					"class": "formulaLine"
				},
				"labWin": {
					"type": "text",
					"left": 32,
					"top": 306,
					"width": 656,
					"height": 24,
					"text": "",
					"class": "formulaLine"
				},
				"LabVisual": {
					"type": "webArea",
					"left": 32,
					"top": 342,
					"width": 656,
					"height": 124,
					"class": "surface",
					"borderStyle": "solid"
				},
				"btnUseDisplay": {
					"type": "button",
					"left": 32,
					"top": 478,
					"width": 150,
					"height": 30,
					"text": "Use my display",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"presetRetina": {
					"type": "button",
					"left": 190,
					"top": 478,
					"width": 120,
					"height": 30,
					"text": "Retina 2×",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"presetMore": {
					"type": "button",
					"left": 318,
					"top": 478,
					"width": 130,
					"height": 30,
					"text": "More space",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"presetWin125": {
					"type": "button",
					"left": 456,
					"top": 478,
					"width": 110,
					"height": 30,
					"text": "Win 125%",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"presetWin150": {
					"type": "button",
					"left": 574,
					"top": 478,
					"width": 110,
					"height": 30,
					"text": "Win 150%",
					"style": "roundedBevel",
					"class": "action",
					"events": [
						"onClick"
					]
				},
				"hint1": {
					"type": "text",
					"left": 32,
					"top": 518,
					"width": 656,
					"height": 18,
					"text": "macOS: scale = native panel pixels ÷ UI point width.",
					"class": "muted"
				},
				"hint2": {
					"type": "text",
					"left": 32,
					"top": 536,
					"width": 656,
					"height": 18,
					"text": "Windows: scale = effective DPI ÷ 96.",
					"class": "muted"
				}
			}
		}
	]
}
